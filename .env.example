# 공급자 선택 후 필요한 서버용 변수 이름을 빈 값으로 추가합니다.
# 실제 API 키는 .env.local에 저장하고 커밋하지 않습니다.

# W01-05 TTS 후보 평가용. 사용할 공급자 항목만 .env.local에 복사합니다.
# Azure AI Speech (무료 F0 리소스 사용)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral
AZURE_TTS_VOICE=ko-KR-InJoonNeural

# ElevenLabs 무료 플랜 (비상업용 평가)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
