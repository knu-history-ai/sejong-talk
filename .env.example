# 공급자 선택 후 필요한 서버용 변수 이름을 빈 값으로 추가합니다.
# 실제 API 키는 .env.local에 저장하고 커밋하지 않습니다. NEXT_PUBLIC_ 접두사 금지.

# 배포 시 실제 웹사이트의 origin을 설정합니다(끝의 / 없이).
# 예: https://sejong.example
# localhost 개발은 비워도 됩니다. npm start로 시험할 때는 실제 localhost 주소를 지정합니다.
APP_ORIGIN=

# Azure Speech (server only). TTS와 STT가 같은 Speech F0 리소스의 키·지역을 함께 사용합니다.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# W01-05 TTS 평가용. 현재 서비스 음성은 InJoonNeural, 속도 -5%, 기본 음높이입니다.
AZURE_TTS_VOICE=ko-KR-InJoonNeural

# STT 공급자 선택: azure | clova | deepgram | groq | elevenlabs
# 서비스 기본값은 azure (Speech Free F0, Short Audio REST).
STT_PROVIDER=azure

# 아래는 개발용 STT 비교에서만 사용합니다. 비워 두면 해당 공급자는 "설정 필요"로 표시됩니다.
CLOVA_SPEECH_SECRET_KEY=
# 단문: https://clovaspeech-gw.ncloud.com/recog/v1/stt
# 장문: 콘솔의 https://clovaspeech-gw.ncloud.com/external/v1/.../... 기본 URL
CLOVA_SPEECH_INVOKE_URL=
DEEPGRAM_API_KEY=
GROQ_API_KEY=

# W01-05 TTS 후보 평가용. 사용할 공급자 항목만 .env.local에 복사합니다.
# ElevenLabs 무료 플랜 (비상업용 평가)
# API 키는 개발용 STT 비교와 함께 사용합니다.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Typecast API 무료 플랜
TYPECAST_API_KEY=
TYPECAST_VOICE_ID=
TYPECAST_VOICE_ID_ALT=
TYPECAST_TTS_MODEL=ssfm-v30

# Ollama/Qwen LLM 답변 생성 (server only). 로컬 Ollama 서버를 먼저 실행합니다.
# 준비 예: ollama pull qwen3.5:4b-q4_K_M
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b-q4_K_M
OLLAMA_TIMEOUT_MS=60000
OLLAMA_MAX_ATTEMPTS=1

# API 키만 넣으면 호출되지 않습니다. 무료 계정을 확인한 뒤 아래 호출 허용 목록도 설정하세요.
# 설정 후 개발 서버를 다시 시작하세요. 자세한 순서는 docs/ARCHITECTURE.md를 참고하세요.
# W03-02: 사용량 기록은 영구 로컬 디스크에 저장합니다. Node 24 단일 호스트용.
# 공급자 콘솔에서 카드 없는 무료 계정/리소스임을 확인한 항목만 추가하세요.
# 예: USAGE_PROVIDER_PLANS='{"ollama:llm_generation":{"mode":"free","maxCostMicros":0},"azure:stt":{"mode":"free","maxCostMicros":0},"azure:tts":{"mode":"free","maxCostMicros":0}}'
# 미설정/확인되지 않은 공급자와 모든 paid 설정은 호출 전에 차단합니다.
USAGE_PROVIDER_PLANS={}
USAGE_DB_PATH=private/usage/ledger.sqlite
USAGE_MAX_CONCURRENT=5
USAGE_CALLS_PER_MINUTE=60
USAGE_SESSION_PER_MINUTE=6
USAGE_COMPLETED_TURNS=30
# 단위는 USD의 백만분의 1. 현재 버전은 유료 호출을 허용하지 않습니다.
USAGE_DAILY_BUDGET_MICROS=0
USAGE_MONTHLY_BUDGET_MICROS=0

# 실시간 음성 PoC (ElevenLabs Speech Engine). 유료 계정이므로 기본은 꺼 둡니다.
# 1이면 /realtime-voice-test 화면과 /api/realtime-poc/token 이 열립니다.
# ELEVENLABS_API_KEY는 위 항목을 함께 씁니다. 키는 서버에만 두고 브라우저로 보내지 않습니다.
REALTIME_POC_ENABLED=
# npm run realtime-poc:engine -- --ws-url=wss://<공개주소>/ws --apply 로 만든 seng_... ID
ELEVENLABS_SPEECH_ENGINE_ID=
# 대화 토큰 발급 제한(분당, 서버 프로세스 기준)
REALTIME_POC_TOKENS_PER_MINUTE=6
# Speech Engine WebSocket 서버(npm run realtime-poc:server)
REALTIME_POC_WS_PORT=3001
REALTIME_POC_WS_PATH=/ws
# 비우면 고정 답변(mock). Bedrock 연결부가 생기면 answer({ transcript, signal }) 모듈 경로를 넣습니다.
REALTIME_POC_ANSWER_MODULE=
# 한국어 지원 TTS 모델. 음질 비교(#95) 결과에 따라 바꿉니다.
REALTIME_POC_TTS_MODEL=eleven_flash_v2_5
