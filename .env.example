# 공급자 선택 후 필요한 서버용 변수 이름을 빈 값으로 추가합니다.
# 실제 API 키는 .env.local에 저장하고 커밋하지 않습니다. NEXT_PUBLIC_ 접두사 금지.

# Azure Speech (server only). TTS와 STT가 같은 Speech F0 리소스의 키·지역을 함께 사용합니다.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# W01-05 TTS 평가용. 현재 서비스 음성은 InJoonNeural, 속도 -5%, 기본 음높이입니다.
AZURE_TTS_VOICE=ko-KR-InJoonNeural

# STT 공급자 선택: azure | clova | deepgram | groq | elevenlabs
# 서비스 기본값은 azure (Speech Free F0, Short Audio REST).
STT_PROVIDER=azure

# 아래는 개발용 STT 비교에서만 사용합니다. 비워 두면 해당 공급자는 "설정 필요"로 표시됩니다.
CLOVA_SPEECH_SECRET_KEY=
# 단문: https://clovaspeech-gw.ncloud.com/recog/v1/stt
# 장문: 콘솔의 https://clovaspeech-gw.ncloud.com/external/v1/.../... 기본 URL
CLOVA_SPEECH_INVOKE_URL=
DEEPGRAM_API_KEY=
GROQ_API_KEY=

# W01-05 TTS 후보 평가용. 사용할 공급자 항목만 .env.local에 복사합니다.
# ElevenLabs 무료 플랜 (비상업용 평가)
# API 키는 개발용 STT 비교와 함께 사용합니다.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Typecast API 무료 플랜
TYPECAST_API_KEY=
TYPECAST_VOICE_ID=
TYPECAST_VOICE_ID_ALT=
TYPECAST_TTS_MODEL=ssfm-v30

# Gemini LLM 무료 후보 시험 (server only). 카드 등록·유료 전환은 멘토님과 먼저 협의합니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_ATTEMPTS=4
