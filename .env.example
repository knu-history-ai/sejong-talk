# 공급자 선택 후 필요한 서버용 변수 이름을 빈 값으로 추가합니다.
# 실제 API 키는 .env.local에 저장하고 커밋하지 않습니다.

# Azure Speech TTS (server only)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Gemini LLM candidate test (server only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_ATTEMPTS=4

# Local evaluation guardrails
AI_DAILY_TEST_BUDGET_USD=1
AI_MONTHLY_TEST_BUDGET_USD=5
