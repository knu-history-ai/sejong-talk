# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Project private files
# 생성된 Next.js .gitignore에 아래 항목이 없는 경우 추가
.env*
!.env.example
.DS_Store
references/private/
private/
*.pem
*.key
service-account*.json

# Local TTS evaluation output (generated audio and API measurements)
/evals/sejong/w01-05-results/
# tts의 샘플 음성 폴더
evals/

# next dev --experimental-https 로컬 인증서
certificates/

# AI evaluation outputs and local npm cache
.npm-cache/
/evals/**/results/
/evals/**/*.local.*
/evals/**/*.wav
/evals/**/*.mp3
