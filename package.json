{
  "name": "sejong-talk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "eval:ai": "node --conditions=react-server evals/sejong/run-fixed-questions.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "tts:evaluate": "node --env-file-if-exists=.env.local scripts/tts-w01-05.mjs",
    "test": "node --conditions=react-server --test tests/*.test.mjs",
    "test:http": "node --test tests/integration/*.test.mjs",
    "realtime-poc:server": "node --env-file-if-exists=.env.local scripts/realtime-poc/speech-engine-server.mjs",
    "realtime-poc:engine": "node --env-file-if-exists=.env.local scripts/realtime-poc/create-engine.mjs"
  },
  "dependencies": {
    "@elevenlabs/client": "1.32.1",
    "@elevenlabs/elevenlabs-js": "2.75.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x"
  }
}
